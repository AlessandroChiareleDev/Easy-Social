# Tunnel URLs — update these after each `cloudflared tunnel` restart
# Then restart Vite: the frontend will pick up the new URLs automatically.
#
# To use: copy this to .env.tunnel (or rename) and Vite loads it via mode.
# Or just set these in the regular .env file when using tunnels.

VITE_TUNNEL_BACKEND=https://investments-cab-pickup-preserve.trycloudflare.com/api
VITE_TUNNEL_PYTHON=https://hosting-jungle-yrs-order.trycloudflare.com
